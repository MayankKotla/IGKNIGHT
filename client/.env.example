# Copy this file to .env and fill in real values.
# For local development, keep VITE_API_URL pointing at your local server.
# For a production deploy (e.g. Vercel), set these as environment variables
# in the hosting platform's project settings instead — Vite bakes them into
# the build at build time, so they must be set BEFORE building/deploying.

# Supabase project URL and anon (public) key — find both in
# Supabase Dashboard > Settings > API. Safe to expose client-side.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL of the deployed Express backend (see server/.env.example).
# Local dev:
VITE_API_URL=http://localhost:3001
# Production example:
# VITE_API_URL=https://your-backend.onrender.com

# Optional — Sentry error monitoring. Leave unset to disable entirely (safe
# for local dev). Create a free project at sentry.io > choose "React" >
# copy the DSN it gives you. Set this in your hosting platform's env vars
# for production so runtime errors are actually visible instead of silent.
# VITE_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
