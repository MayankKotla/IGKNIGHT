# Copy this file to .env and fill in real values.
# For a production deploy (Render/Railway/Fly/etc.), set these as
# environment variables in the hosting platform's dashboard instead of
# committing a .env file.

PORT=3001

# URL of the deployed frontend — must match exactly (including protocol,
# no trailing slash) or the browser's CORS check will block every request.
# Local dev:
CLIENT_URL=http://localhost:5173
# Production example:
# CLIENT_URL=https://igknight.vercel.app

# Supabase project — find these in Supabase Dashboard > Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# service_role key — NEVER expose this client-side, backend only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key — console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key

# Google Cloud OAuth client (for Google Meet link generation).
# Create at console.cloud.google.com > APIs & Services > Credentials.
# Calendar API must be enabled on the project.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Generate with: node scripts/getRefreshToken.js
# Note: while your Google Cloud OAuth consent screen is in "Testing" mode,
# this refresh token expires after 7 days and needs regenerating. Move the
# app out of Testing mode (requires Google verification for the Calendar
# scope) before relying on this in production.
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Optional — Sentry error monitoring. Leave unset to disable entirely (safe
# for local dev). Use the SAME Sentry project as the client's
# VITE_SENTRY_DSN if you want client and server errors in one place, or a
# separate "Node" project if you'd rather keep them apart.
# SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
